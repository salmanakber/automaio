# Database Configuration
DATABASE_URL=postgresql://automaio_user:salmankhan12@localhost:5432/Automaio

# Redis Configuration (for BullMQ workers)
REDIS_URL=redis://localhost:6379

# Authentication
NEXTAUTH_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000
# Production: https://automaio.kilo1app.com — must match NEXTAUTH_URL (required for Webflow Designer links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Model APIs (add keys for providers you use in Admin → AI Config)
# Google Gemini — recommended default (cheap): https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=alias-for-gemini-if-preferred

OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GROQ_API_KEY=your-groq-key

# Budget / alternative providers (optional)
DEEPSEEK_API_KEY=your-deepseek-key
MISTRAL_API_KEY=your-mistral-key
TOGETHER_API_KEY=your-together-key
OPENROUTER_API_KEY=your-openrouter-key

# Webflow App Marketplace (OAuth — recommended)
WEBFLOW_CLIENT_ID=your-webflow-app-client-id
WEBFLOW_CLIENT_SECRET=your-webflow-app-client-secret
# Optional; defaults to {NEXTAUTH_URL}/api/integrations/webflow/oauth/callback
WEBFLOW_REDIRECT_URI=http://localhost:3000/api/integrations/webflow/oauth/callback

# Google sign-in (optional — Designer + auth pages)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Fallback: manual Site API token with CMS read/write scope
WEBFLOW_API_KEY=your-webflow-site-api-token

# Email delivery (fallback chain: Brevo → Resend → Amazon SES)
EMAIL_FROM=noreply@yourdomain.com
BREVO_API_KEY=your-brevo-api-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@yourdomain.com
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
SES_FROM_EMAIL=noreply@yourdomain.com

# Webhook URLs (Optional)
WEBHOOK_SECRET=your-webhook-secret

# Cloudinary (studio media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Unsigned upload preset (recommended for dev) — create in Cloudinary dashboard
CLOUDINARY_UPLOAD_PRESET=automaio_unsigned

# Application Settings
NODE_ENV=development
PORT=3000

# Feature Flags
ENABLE_AI_COST_OPTIMIZATION=true
ENABLE_AUTO_SCHEDULING=true
ENABLE_WEBFLOW_INTEGRATION=true
ENABLE_COMPLIANCE_CHECKING=true

# Worker Configuration
WORKER_CONCURRENCY_CAMPAIGN=3
WORKER_CONCURRENCY_CONTENT=5
WORKER_CONCURRENCY_SCHEDULE=2
WORKER_CONCURRENCY_ANALYTICS=5

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=optional-sentry-dsn
