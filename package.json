{
  "name": "automaio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n NEXT,WORKER,WEBFLOW -c blue,green,yellow \"next dev -p 3301\" \"tsx watch server/worker-server.ts\" \"cd webflow-designer-ext && npx @webflow/webflow-cli extension serve\"",
    "build": "next build",
    "build:all": "npm run build && npm run webflow:extension:bundle",
    "start": "concurrently -n NEXT,WORKER -c blue,green \"next start\" \"tsx server/worker-server.ts\"",
    "lint": "eslint .",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "worker": "tsx watch server/worker-server.ts",
    "worker:start": "tsx server/worker-server.ts",
    "webflow:extension": "cd webflow-designer-ext && npx --yes @webflow/webflow-cli extension serve",
    "webflow:extension:build": "cd webflow-designer-ext && npx --yes @webflow/webflow-cli extension build",
    "webflow:extension:sync-shell": "mkdir -p public/webflow/extension-shell && cp webflow-designer-ext/public/designer-bridge.js public/webflow/extension-shell/designer-bridge.js",
    "webflow:extension:bundle": "npm run webflow:extension:sync-shell && cd webflow-designer-ext && npx --yes @webflow/webflow-cli extension bundle",
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1053.0",
    "@google/genai": "^2.3.0",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
